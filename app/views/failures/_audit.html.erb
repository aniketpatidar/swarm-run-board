<%# frozen_string_literal: true %>

<%= render(JetUi::Card::Component.new(id: "audit_trail")) do %>
  <%= render(JetUi::Card::HeaderComponent.new) do %>
    <%= render(JetUi::Card::TitleComponent.new) { "Audit trail" } %>
  <% end %>

  <%= render(JetUi::Card::BodyComponent.new) do %>
    <% if run.audit_entries.any? %>
      <%= render(JetUi::List::Component.new(variant: :divided)) do %>
        <% run.audit_entries.order(created_at: :desc, id: :desc).each do |entry| %>
          <%= render(JetUi::List::ItemComponent.new) do %>
            <p class="text-sm break-words">
              <strong class="font-semibold"><%= entry.action %></strong>: <%= entry.subject %>
            </p>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <p class="text-sm text-muted-foreground">No audit entries yet.</p>
    <% end %>
  <% end %>
<% end %>