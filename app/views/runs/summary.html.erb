# frozen_string_literal: true

<section id="run_summary">
  <h1><%= @run.mission %></h1>

  <dl>
    <dt>Status</dt>
    <dd><%= @run.status == "finished" ? "Completed" : @run.status.titleize %></dd>

    <dt>Started</dt>
    <dd><%= @run.started_at.to_date %></dd>

    <dt>Ended</dt>
    <dd><%= @run.ended_at&.to_date %></dd>

    <dt>Cards completed</dt>
    <dd><%= @run.cards.where(current_role: "done").count %></dd>

    <dt>Total cost</dt>
    <dd><%= format("%.2f", @run.cost_entries.sum(:cost)) %></dd>

    <dt>Resolved failures</dt>
    <dd><%= @run.failures.where.not(resolved_at: nil).count %></dd>

    <dt>Open failures</dt>
    <dd><%= @run.failures.open.count %></dd>
  </dl>

  <%= link_to "Back to board", root_path %>
</section>