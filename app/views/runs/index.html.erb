<%# frozen_string_literal: true %>

<%= render(JetUi::Header::Component.new) do %>
  <%= render(JetUi::Header::HeadingComponent.new) do %>
    <%= render(JetUi::Header::TitleComponent.new) { "Run board" } %>
  <% end %>

  <%= render(JetUi::Header::ActionsComponent.new) do %>
    <%= render(JetUi::Btn::Component.new(url: new_run_path)) { "New run" } %>
  <% end %>
<% end %>

<%= render(JetUi::Table::Component.new(id: "runs", hovered: true)) do %>
  <thead>
    <tr>
      <th>Mission</th>
      <th>Pack kind</th>
      <th>Status</th>
      <th>Started</th>
    </tr>
  </thead>
  <tbody id="runs_rows">
    <% if @runs.any? %>
      <%= render partial: "runs/run", collection: @runs %>
    <% else %>
      <tr id="runs_empty">
        <td colspan="4">
          <%= render(JetUi::Empty::Component.new) do %>
            <%= render(JetUi::Empty::IconComponent.new("list-bullet", size: 8)) %>
            <h3 class="empty__title">No runs yet</h3>
            <p class="text-zinc-500">Start your first swarm run and it will show up here.</p>
            <%= render(JetUi::Empty::ActionsComponent.new) do %>
              <%= render(JetUi::Btn::Component.new(variant: :outline, url: new_run_path)) { "New run" } %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
<% end %>