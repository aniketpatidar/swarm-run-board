<%# frozen_string_literal: true %>

<%= render(JetUi::Header::Component.new) do %>
  <%= render(JetUi::Header::HeadingComponent.new) do %>
    <%= render(JetUi::Header::TitleComponent.new) { "New run" } %>
  <% end %>

  <%= render(JetUi::Header::ActionsComponent.new) do %>
    <%= render(JetUi::Btn::Component.new(variant: :ghost, url: root_path)) { "Back to board" } %>
  <% end %>
<% end %>

<%= render(JetUi::Card::Component.new(id: "new-run-card")) do %>
  <% if @run.errors.any? %>
    <%= render(JetUi::Alert::Component.new(variant: :error, class: "mb-4")) do %>
      <%= render(JetUi::Alert::TitleComponent.new) { "Couldn't create run" } %>
      <ul class="list-disc pl-5 mt-2">
        <% @run.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%= render(JetUi::Card::BodyComponent.new) do %>
    <%= form_with model: @run, url: runs_path, class: "space-y-4" do |form| %>
      <div class="field">
        <%= form.label :mission, "Mission", class: "block text-sm font-medium mb-1.5" %>
        <%= form.text_area :mission, required: true, rows: 4, class: "block w-full rounded-md border border-(--color-input) px-3 py-2 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--color-ring)" %>
      </div>

      <div class="field">
        <%= form.label :pack_kind, "Pack kind", class: "block text-sm font-medium mb-1.5" %>
        <%= form.select :pack_kind, Run::PACK_KINDS, {}, class: "block w-full rounded-md border border-(--color-input) px-3 py-2 text-sm" %>
      </div>

      <div class="pt-2">
        <%= form.button "Create run", class: "btn btn-default btn-md" %>
      </div>
    <% end %>
  <% end %>
<% end %>