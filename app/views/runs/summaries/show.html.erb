<%# frozen_string_literal: true %>

<%= render(JetUi::Header::Component.new) do %>
  <%= render(JetUi::Header::HeadingComponent.new) do %>
    <%= render(JetUi::Header::TitleComponent.new(class: "[overflow-wrap:anywhere]")) { @run.mission } %>
    <%= render(JetUi::Header::SubtitleComponent.new) { "Summary" } %>
  <% end %>

  <%= render(JetUi::Header::ActionsComponent.new) do %>
    <%= render(JetUi::Btn::Component.new(variant: :ghost, url: root_path)) { "Back to board" } %>
  <% end %>
<% end %>

<section id="run_summary">
  <%= render(JetUi::Card::Component.new) do %>
    <%= render(JetUi::Card::HeaderComponent.new) do %>
      <%= render(JetUi::Card::TitleComponent.new) do %>
        <%= @run.status == "finished" ? "Completed" : @run.status.titleize %>
      <% end %>
      <%= render(JetUi::Card::SubtitleComponent.new) do %>
        <%= @run.pack_kind %> run
      <% end %>
    <% end %>

    <%= render(JetUi::Card::BodyComponent.new) do %>
      <dl class="grid grid-cols-1 gap-x-8 sm:grid-cols-2">
        <div class="flex items-center justify-between gap-4 border-b border-(--color-border) py-2.5">
          <dt class="text-sm text-muted-foreground">Status</dt>
          <dd class="font-medium"><%= @run.status == "finished" ? "Completed" : @run.status.titleize %></dd>
        </div>

        <div class="flex items-center justify-between gap-4 border-b border-(--color-border) py-2.5">
          <dt class="text-sm text-muted-foreground">Started</dt>
          <dd class="font-medium"><%= @run.started_at.to_date %></dd>
        </div>

        <div class="flex items-center justify-between gap-4 border-b border-(--color-border) py-2.5">
          <dt class="text-sm text-muted-foreground">Ended</dt>
          <dd class="font-medium"><%= @run.ended_at&.to_date || "—" %></dd>
        </div>

        <div class="flex items-center justify-between gap-4 border-b border-(--color-border) py-2.5">
          <dt class="text-sm text-muted-foreground">Cards completed</dt>
          <dd class="font-medium"><%= @run.completed_cards_count %></dd>
        </div>

        <div class="flex items-center justify-between gap-4 border-b border-(--color-border) py-2.5">
          <dt class="text-sm text-muted-foreground">Total cost</dt>
          <dd class="font-medium"><%= format("%.2f", @run.total_cost) %></dd>
        </div>

        <div class="flex items-center justify-between gap-4 border-b border-(--color-border) py-2.5">
          <dt class="text-sm text-muted-foreground">Resolved failures</dt>
          <dd class="font-medium"><%= @run.resolved_failures_count %></dd>
        </div>

        <div class="flex items-center justify-between gap-4 py-2.5">
          <dt class="text-sm text-muted-foreground">Open failures</dt>
          <dd class="font-medium"><%= @run.open_failures_count %></dd>
        </div>
      </dl>
    <% end %>
  <% end %>
</section>