# frozen_string_literal: true

<h1><%= @run.mission %></h1>

<p>
  <strong>Pack kind:</strong> <%= @run.pack_kind %>
  <strong>Status:</strong> <%= @run.status %>
</p>

<%= link_to "Back to board", root_path %>

<ul id="cards">
  <% @run.cards.each do |card| %>
    <%= render partial: "cards/card", locals: { card: card, run: @run } %>
  <% end %>
</ul>