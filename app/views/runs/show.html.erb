# frozen_string_literal: true

<h1><%= @run.mission %></h1>

<p>
  <strong>Pack kind:</strong> <%= @run.pack_kind %>
  <strong>Status:</strong> <%= @run.status %>
</p>

<%= link_to "Back to board", root_path %>
<%= link_to "Summary", run_summary_path(@run) %>

<ul id="cards">
  <%= render @run.cards %>
</ul>

<section id="agent_messages">
  <h2>Agent messages</h2>

  <ul id="agent_messages_list">
    <%= render @run.agent_messages %>
  </ul>

  <%= form_with model: [@run, AgentMessage.new] do |form| %>
    <%= form.label :body, "Message" %>
    <%= form.text_area :body %>
    <%= form.label :to_role, "To role" %>
    <%= form.select :to_role, Card::WORKFLOW_ROLES, include_blank: true %>
    <%= form.submit "Post message" %>
  <% end %>
</section>

<%= render partial: "cost_entries/rollup", locals: { run: @run } %>

<%= render partial: "failures/triage", locals: { run: @run } %>

<%= render partial: "failures/audit", locals: { run: @run } %>
